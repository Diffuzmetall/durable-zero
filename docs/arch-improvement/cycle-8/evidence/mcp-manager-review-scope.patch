+    assert.equal(row.lastStop, "stop");
+    await native.harness.commit(tx => tx.appendEntry(native.child.id, { kind: "pi.assistant", model: [{ ...assistant, stopReason: "aborted" }] }), context);
+    assert.equal((await loadSummaries(native.harness, native.root.id)).find(row => row.id === native.child.id)?.lastStop, "aborted");
+  } finally { await native.close(); }
+});
+
+test("native durable.subagents metadata supplies names/tasks; parent prose is not completion evidence", async () => {
+  const native = await nativeRuntimeState();
+  try {
+    const input = [{ id: native.child.id, label: `subagent ${native.child.id}` }];
+    // Minimal metadata fixture: no native task execution or admission receipt is claimed.
+    const doc = { agents: { worker: { name: "named-worker", conversationId: native.child.id, task: "Check the actual file", role: "checker" } } } as SubagentsState;
+    const rows = applySubagentSummaries(input, native.root.id, doc);
+    assert.equal(rows[0].label, "named-worker");
+    assert.equal(rows[0].title, "Check the actual file");
+    assert.equal(rows[0].role, "checker");
+    assert.equal(rows[0].parentId, native.root.id);
+    assert.equal(rows[0].lastStop, undefined);
+    assert.equal(input[0].label, `subagent ${native.child.id}`, "projection mutated native source");
+  } finally { await native.close(); }
+});
diff --git a/packages/local-runtime/src/mcp-ui.ts b/packages/local-runtime/src/mcp-ui.ts
new file mode 100644
index 0000000..1d7345d
--- /dev/null
+++ b/packages/local-runtime/src/mcp-ui.ts
@@ -0,0 +1,111 @@
+import { TuiMainScreen, KeybindingsManager, TUI_KEYBINDINGS, getKeybindings, setKeybindings, type TUI, type Component, type Terminal } from "@earendil-works/pi-tui";
+import { Theme, initTheme, ExtensionInputComponent, ExtensionSelectorComponent, type ExtensionUIContext, type KeybindingsManager as PiKeybindingsManager } from "@earendil-works/pi-coding-agent";
+import { z } from "zod";
+import type { McpTerminalOperation } from "./client.ts";
+
+export const mcpViewport = z.object({
+  columns: z.number().int().min(1).max(10000), rows: z.number().int().min(1).max(10000),
+  kittyProtocolActive: z.boolean(),
+});
+export const mcpCommandRequest = mcpViewport.extend({
+  args: z.string(), keybindings: z.record(z.string(), z.union([z.string(), z.array(z.string())])), colors: z.record(z.string(), z.string().regex(/^(?:#[0-9a-f]{6}|)$/i)),
+}).strict();
+
+/** An output device for Pi's real TUI. Rendering and input dispatch remain native Pi code. */
+class RemoteTerminal implements Terminal {
+  #input: ((data: string) => void) | undefined;
+  #resize: (() => void) | undefined;
+  #cancelled = false;
+  #cancelQueued = false;
+  constructor(public viewport: z.infer<typeof mcpViewport>,
+    private send: (operation: McpTerminalOperation) => void,
+    private request: (operation: McpTerminalOperation) => Promise<unknown>) {}
+  get columns() { return this.viewport.columns; }
+  get rows() { return this.viewport.rows; }
+  get kittyProtocolActive() { return this.viewport.kittyProtocolActive; }
+  start(input: (data: string) => void, resize: () => void) {
+    this.#input = input; this.#resize = resize;
+    if (this.#cancelled) this.#cancel();
+  }
+  stop() { this.#input = undefined; this.#resize = undefined; }
+  input(data: string) { if (!this.#cancelled) this.#input?.(data); }
+  resize(viewport: z.infer<typeof mcpViewport>) { this.viewport = viewport; this.#resize?.(); }
+  disconnect() { this.#cancelled = true; this.#cancel(); }
+  #cancel() {
+    if (this.#cancelQueued || !this.#input) return;
+    this.#cancelQueued = true;
+    setImmediate(() => { this.#cancelQueued = false; this.#input?.("\x1b"); });
+  }
+  write(data: string) {
+    if (this.#cancelled) {
+      // Cancel each newly rendered nested menu, until the native manager exits itself.
+      this.#cancel();
+    } else this.send({ op: "write", data });
+  }
+  async drainInput(maxMs?: number, idleMs?: number) {
+    if (!this.#cancelled) await this.request({ op: "drainInput", maxMs, idleMs });
+  }
+  moveBy(lines: number) { if (lines) this.write(`\x1b[${Math.abs(lines)}${lines > 0 ? "B" : "A"}`); }
+  hideCursor() { this.write("\x1b[?25l"); }
+  showCursor() { this.write("\x1b[?25h"); }
+  clearLine() { this.write("\x1b[2K\r"); }
+  clearFromCursor() { this.write("\x1b[J"); }
+  clearScreen() { this.write("\x1b[2J\x1b[H"); }
+  setTitle(title: string) { if (!this.#cancelled) this.send({ op: "setTitle", title }); }
+  setProgress(active: boolean) { if (!this.#cancelled) this.send({ op: "setProgress", active }); }
+  setProgramStatus(status: Parameters<Terminal["setProgramStatus"]>[0]) {
+    if (!this.#cancelled) this.send({ op: "setProgramStatus", status });
+  }
+}
+
+/** One command's UI, not a Harness, MCP client, or replacement manager. */
+export function createMcpCommandUI(options: z.infer<typeof mcpCommandRequest>,
+  send: (operation: McpTerminalOperation) => void,
+  request: (operation: McpTerminalOperation) => Promise<unknown>,
+  notice: (message: string, level: "info" | "warning" | "error") => void) {
+  initTheme();
+  const theme = new Theme(options.colors as ConstructorParameters<typeof Theme>[0],
+    options.colors as ConstructorParameters<typeof Theme>[1], "truecolor");
+  const definitions = { ...TUI_KEYBINDINGS, ...Object.fromEntries(Object.keys(options.keybindings).map(key => [key, { defaultKeys: [] }])) };
+  // MCP uses the public TUI keybinding methods. Pi's additional file-loader class is not a runtime SDK export.
+  const keybindings = new KeybindingsManager(definitions, options.keybindings as ConstructorParameters<typeof KeybindingsManager>[1]) as PiKeybindingsManager;
+  const terminal = new RemoteTerminal(options, send, request);
+  async function custom<T>(
+    factory: (tui: TUI, theme: Theme, keys: PiKeybindingsManager, done: (value: T) => void) => ReturnType<Parameters<ExtensionUIContext["custom"]>[0]>,
+    customOptions?: Parameters<ExtensionUIContext["custom"]>[1],
+  ): Promise<T> {
+    if (customOptions?.overlay) throw new Error("MCP command UI does not support overlay components");
+    const previousKeys = getKeybindings();
+    setKeybindings(keybindings);
+    const tui = new TuiMainScreen(terminal);
+    let done!: (value: T) => void;
+    const result = new Promise<T>(resolve => { done = resolve; });
+    let component: (Component & { dispose?(): void }) | undefined;
+    try {
+      component = await factory(tui, theme, keybindings, done);
+      tui.addChild(component);
+      tui.setFocus(component);
+      tui.start();
+      return await result;
+    } finally {
+      tui.stop();
+      component?.dispose?.();
+      setKeybindings(previousKeys);
+    }
+  }
+  const ui: Pick<ExtensionUIContext, "custom" | "select" | "input" | "notify" | "theme"> = {
+    theme, custom, notify: (message, level = "info") => notice(message, level),
+    select: (title, choices, options) => custom((tui, _theme, _keys, done) =>
+      new ExtensionSelectorComponent(title, choices, done, () => done(undefined), { tui, ...options })),
+    input: (title, placeholder, options) => custom((tui, _theme, _keys, done) =>
+      new ExtensionInputComponent(title, placeholder, done, () => done(undefined), { tui, ...options })),
+  };
+  return { ui, input: (data: string) => terminal.input(data),
+    resize: (viewport: z.infer<typeof mcpViewport>) => terminal.resize(viewport),
+    disconnect: () => {
+      // The terminal is gone: restore a known cancel key on this command-owned manager only.
+      // Native menus must unwind themselves, including their subscriptions and sign-in cancellation.
+      keybindings.setUserBindings({ "tui.select.cancel": "escape" });
+      terminal.disconnect();
+    } };
+}
diff --git a/packages/local-runtime/test/mcp-startup-native.test.ts b/packages/local-runtime/test/mcp-startup-native.test.ts
new file mode 100644
index 0000000..abeba69
--- /dev/null
+++ b/packages/local-runtime/test/mcp-startup-native.test.ts
@@ -0,0 +1,120 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import http from "node:http";
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { mkdtemp, mkdir, readFile, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { setTimeout as delay } from "node:timers/promises";
+import { connectRuntime } from "../src/client.ts";
+
+const source = fileURLToPath(new URL("../../../", import.meta.url));
+const root = process.env.ZERO_RUNTIME_ROOT ?? source;
+const installed = process.env.ZERO_INSTALLED_PREFIX;
+const runtimeModule = installed ? join(installed, "node_modules/@local-durable/runtime/dist/index.js") : join(root, "packages/local-runtime/dist/index.js");
+async function until(check: () => boolean | Promise<boolean>, label: string, maxMs = 4000) {
+  const deadline = Date.now() + maxMs;
+  while (!await check()) { assert.ok(Date.now() < deadline, label); await delay(20); }
+}
+
+test("optional MCP stalled after initialize cannot block startup/reload; native shutdown cancels its transport", { timeout: 20000 }, async t => {
+  const base = await mkdtemp(join(tmpdir(), "zero-mcp-startup-"));
+  const agent = join(base, "agent"), cwd = join(base, "workspace"), sessionDir = join(base, "session");
+  await mkdir(agent); await mkdir(cwd);
+  const toolResponse = join(base, "provider-tool-response.json");
+  let initialized = 0, cancelled = 0;
+  const pending = new Set<http.ServerResponse>();
+  const server = http.createServer(async (req, res) => {
+    let body = "";
+    for await (const chunk of req) body += chunk;
+    if (req.method !== "POST") { res.writeHead(405); res.end(); return; }
+    const message = JSON.parse(body);
+    if (message.method === "initialize") {
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end(JSON.stringify({ jsonrpc: "2.0", id: message.id, result: {
+        protocolVersion: message.params.protocolVersion, capabilities: {}, serverInfo: { name: "owned-stalled-peer", version: "1" },
+      } }));
+    } else if (message.method === "notifications/initialized") {
+      initialized++; pending.add(res);
+      res.once("close", () => { pending.delete(res); cancelled++; });
+      // Deliberately never acknowledge this POST: MCP requestTimeoutMs does not cover notifications.
+    } else { res.writeHead(200, { "content-type": "application/json" }); res.end(JSON.stringify({ jsonrpc: "2.0", id: message.id, result: { tools: [] } })); }
+  });
+  server.listen(0, "127.0.0.1"); await once(server, "listening");
+  await writeFile(join(agent, "mcp.json"), JSON.stringify({ mcpServers: { stalled: {
+    url: `http://127.0.0.1:${(server.address() as import("node:net").AddressInfo).port}/mcp`,
+    headers: { Authorization: "Bearer isolated-test-fixture" }, exposure: "codemode", timeout: 1,
+  } } }));
+  const workerPath = join(base, "worker.mjs");
+  await writeFile(workerPath, `
+    import { startRuntime } from ${JSON.stringify(pathToFileURL(runtimeModule).href)};
+    const runtime = await startRuntime(${JSON.stringify({ sessionDir, cwd, extensions: [process.env.ZERO_PROVIDER_FIXTURE ?? join(source, "packages/local-runtime/test/fixtures/provider.ts")], provider: "local-test", model: "scripted" })});
+    process.on("message", async message => {
+      if (message !== "close") return;
+      await runtime.close();
+      console.log("NATIVE_RUNTIME_CLOSED");
+      process.disconnect();
+    });
+    console.log("NATIVE_RUNTIME_READY");
+  `);
+  const workers: ReturnType<typeof worker>[] = [];
+  const connections: Awaited<ReturnType<typeof connectRuntime>>[] = [];
+  t.after(async () => {
+    for (const client of connections) client.close();
+    for (const { child, exited } of workers) if (child.exitCode === null && child.signalCode === null) {
+      child.kill("SIGTERM");
+      const watchdog = setTimeout(() => child.kill("SIGKILL"), 1000);
+      try { await exited; } finally { clearTimeout(watchdog); }
+    }
+    server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve()));
+    await rm(base, { recursive: true, force: true });
+  });
+  function worker() {
+    const child = spawn(process.execPath, [workerPath], {
+      env: { ...process.env, HOME: join(base, "home"), PI_CODING_AGENT_DIR: agent, PI_ADDITIONAL_EXTENSIONS: "", ZERO_FIXTURE_TOOL_RESPONSE: toolResponse }, stdio: ["ignore", "pipe", "pipe", "ipc"],
+    });
+    let stdout = "", stderr = "";
+    child.stdout.on("data", data => { stdout += data; }); child.stderr.on("data", data => { stderr += data; });
+    const result = { child, exited: once(child, "exit"), stdout: () => stdout, stderr: () => stderr };
+    workers.push(result); return result;
+  }
+  const first = worker();
+  await until(() => first.stdout().includes("NATIVE_RUNTIME_READY"), "stalled notification blocked runtime readiness");
+  await until(() => initialized === 1, "peer did not reach the stalled post-initialize notification");
+  const client = await connectRuntime(sessionDir); connections.push(client);
+  const identity = await client.request("runtime/info");
+  await client.request("session/prompt", { content: "No external model or MCP call" });
+  await until(async () => (await client.request("session/getTranscript") as any).entries.some((entry: any) => entry.role === "assistant"), "optional stalled peer blocked an ordinary native turn");
+  await client.request("session/prompt", { content: "invoke:" + JSON.stringify({ name: "codemode", arguments: { code: 'text(await searchTools("zero_probe"));' } }) });
+  await until(async () => {
+    try { return JSON.parse(await readFile(toolResponse, "utf8")).name === "codemode"; } catch { return false; }
+  }, "offline provider did not produce the real discovery call");
+  const waiting: any = (await client.request("session/getView") as any).view;
+  assert.ok(waiting.conversation.docs["pi.live"].generation, "generation is not awaiting readiness");
+  assert.ok(!Object.values(waiting.tasks.tasks).some((task: any) => task.kind === "pi.tool"), "tool snapshot was taken before MCP readiness");
+  await Promise.race([client.request("session/abort"), delay(2000).then(() => { throw new Error("MCP readiness ignored native abort"); })]);
+  assert.equal((await client.request("session/getView") as any).view.conversation.docs["pi.live"].run, undefined);
+  assert.equal(pending.size, 1, "turn abort unexpectedly disposed the runtime-owned connection");
+  await Promise.race([client.request("session/reload"), delay(4000).then(() => { throw new Error("stalled notification blocked reload"); })]);
+  assert.deepEqual(await client.request("runtime/info"), identity);
+  await until(() => initialized === 2 && cancelled >= 1, "reload did not cancel the old connection before reopening");
+  client.close();
+  first.child.send("close");
+  await until(() => first.child.exitCode !== null, "native close left owned MCP handles alive");
+  await first.exited;
+  assert.equal(first.child.exitCode, 0, first.stderr());
+  assert.match(first.stdout(), /NATIVE_RUNTIME_CLOSED/);
+  assert.equal(pending.size, 0, "shutdown left an initialized notification transport open");
+  // The same directory can be acquired again only after the first native owner closed.
+  const reopened = worker();
+  await until(() => reopened.stdout().includes("NATIVE_RUNTIME_READY"), "native session owner was not released after close");
+  await until(() => initialized === 3, "reopened MCP connection did not start");
+  reopened.child.send("close");
+  await until(() => reopened.child.exitCode !== null, "reopened native close leaked handles");
+  await reopened.exited;
+  assert.equal(reopened.child.exitCode, 0, reopened.stderr());
+  assert.equal(pending.size, 0);
+  console.log("PASS stalled post-initialize HTTP peer: ready, ordinary turn, abortable discovery, reload, transport cancellation, graceful close and same-session reopen");
+});
