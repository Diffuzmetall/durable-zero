{
  "name": "durable-zero",
  "version": "0.27.1-alpha.1",
  "description": "Sovereign, ACID-persisted agent runtime, task graph, QuickJS codemode sandbox, and CLI",
  "type": "module",
  "license": "MIT",
  "author": "Ivan Arc",
  "exports": {
    ".": {
      "types": "./packages/core/src/index.ts",
      "import": "./packages/core/dist/index.js",
      "default": "./packages/core/dist/index.js"
    },
    "./core": {
      "types": "./packages/core/src/index.ts",
      "import": "./packages/core/dist/index.js",
      "default": "./packages/core/dist/index.js"
    },
    "./contracts": {
      "types": "./packages/contracts/src/index.ts",
      "import": "./packages/contracts/dist/index.js",
      "default": "./packages/contracts/dist/index.js"
    },
    "./runner": {
      "types": "./packages/runner/src/index.ts",
      "import": "./packages/runner/dist/index.js",
      "default": "./packages/runner/dist/index.js"
    },
    "./protocol": {
      "types": "./packages/protocol/src/index.ts",
      "import": "./packages/protocol/dist/index.js",
      "default": "./packages/protocol/dist/index.js"
    },
    "./execution": {
      "types": "./packages/execution/src/index.ts",
      "import": "./packages/execution/dist/index.js",
      "default": "./packages/execution/dist/index.js"
    },
    "./adapter-pi-durable": {
      "types": "./packages/adapter-pi-durable/src/index.ts",
      "import": "./packages/adapter-pi-durable/dist/index.js",
      "default": "./packages/adapter-pi-durable/dist/index.js"
    },
    "./adapter-pi-ai": {
      "types": "./packages/adapter-pi-ai/src/index.ts",
      "import": "./packages/adapter-pi-ai/dist/index.js",
      "default": "./packages/adapter-pi-ai/dist/index.js"
    },
    "./adapter-codemode": {
      "types": "./packages/adapter-codemode/src/index.ts",
      "import": "./packages/adapter-codemode/dist/index.js",
      "default": "./packages/adapter-codemode/dist/index.js"
    },
    "./extension-pi-resource": {
      "types": "./packages/extension-pi-resource/src/index.ts",
      "import": "./packages/extension-pi-resource/dist/index.js",
      "default": "./packages/extension-pi-resource/dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./packages/core/src/index.ts"
      ],
      "contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "protocol": [
        "./packages/protocol/src/index.ts"
      ],
      "execution": [
        "./packages/execution/src/index.ts"
      ],
      "adapter-pi-durable": [
        "./packages/adapter-pi-durable/src/index.ts"
      ],
      "adapter-pi-ai": [
        "./packages/adapter-pi-ai/src/index.ts"
      ],
      "adapter-codemode": [
        "./packages/adapter-codemode/src/index.ts"
      ],
      "extension-pi-resource": [
        "./packages/extension-pi-resource/src/index.ts"
      ],
      "runner": [
        "./packages/runner/src/index.ts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.src.json --pretty false",
    "test": "node --test --test-timeout 30000 packages/*/test/*.test.ts",
    "lint": "pnpm -r run lint"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@sinclair/typebox": "^0.34.14",
    "proper-lockfile": "^4.1.2",
    "quickjs-wasi": "3.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
