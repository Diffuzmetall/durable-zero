  "changes": [
    "Replace wire-type re-exports with presentation-only helpers",
    "Use the native public Zero view through a client presentation contract",
    "Remove local session-title reads and all session-title writes",
    "Surface unsupported operations and RPC failures in the existing UI",
    "Forward explicit skill commands to the runtime; picker selection remains insertion-only",
    "Hide disconnected optional attention and automation panels without suppressing runtime notices",
    "Support caller-owned detach signal",
    "Load Photon through its native Node module without filesystem monkey-patching",
    "Reject normal model-picker selections when the native selected conversation changes",
    "Show activity unavailable for native summary rows without live evidence; preserve activity styles and use client-enriched selected native live documents"
  ],
