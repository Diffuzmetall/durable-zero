{
  "name": "@local-durable/runtime",
  "version": "0.27.1-alpha.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" },
    "./client": { "types": "./src/client.ts", "import": "./dist/client.js" },
    "./sessions": { "types": "./src/sessions.ts", "import": "./dist/sessions.js" }
  },
  "bin": { "pi-zero-runtime": "./bin/runtime.mjs" },
  "files": ["bin", "dist", "src"],
  "scripts": {
    "build": "esbuild src/index.ts src/client.ts src/main.ts src/sessions.ts --bundle --packages=external --platform=node --target=node24 --format=esm --outdir=dist",
    "test": "node --test --test-timeout=20000 test/*.test.ts"
  },
  "dependencies": {
    "@durable-zero/runner": "workspace:*",
    "@durable-zero/adapter-pi-durable": "workspace:*",
    "@durable-zero/protocol": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "zod": "^4.6.7"
  }
}
